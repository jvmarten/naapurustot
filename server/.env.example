# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=

# API service
API_DB_PASSWORD=
JWT_SECRET=
TURNSTILE_SECRET=
# Optional — comma-separated hostnames a Turnstile token must be solved on to be
# accepted (e.g. naapurustot.fi,www.naapurustot.fi). Leave empty to skip the check.
TURNSTILE_ALLOWED_HOSTNAMES=

# Optional — Sentry error tracking for the API. Leave empty to disable.
SENTRY_DSN=
SENTRY_RELEASE=

# Optional — days of pg_dump backups to retain in server/backups/ (default 14).
BACKUP_RETENTION_DAYS=
