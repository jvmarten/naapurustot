# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=

# API service
API_DB_PASSWORD=
JWT_SECRET=
# Optional — comma-separated usernames allowed into the private operator dashboard
# (GET /auth/admin, GET /auth/admin/users). Leave empty to disable the dashboard
# entirely (every request is refused). Sign in normally, then open
# https://api.naapurustot.fi/auth/admin. Case-insensitive; e.g. ADMIN_USERNAMES=jvmarten
ADMIN_USERNAMES=
TURNSTILE_SECRET=
# Optional — comma-separated hostnames a Turnstile token must be solved on to be
# accepted (e.g. naapurustot.fi,www.naapurustot.fi). Leave empty to skip the check.
TURNSTILE_ALLOWED_HOSTNAMES=

# Password-reset email via Resend (https://resend.com). Leave RESEND_API_KEY empty
# to disable sending — /auth/forgot-password still answers 200, it just never mails,
# so the API is fully functional without it.
#
# The key is a "Sending access" API key from Resend → API keys. Do NOT reuse the
# `gmail-smtp` key: that one is the SMTP password in Gmail's "Send mail as" setting
# for info@naapurustot.fi, and rotating it silently breaks replying from that address.
RESEND_API_KEY=
# From address. Must be on a domain verified in Resend (naapurustot.fi is, with an
# EU/eu-west-1 return path). Replies are steered to info@naapurustot.fi, which
# Cloudflare Email Routing forwards.
MAIL_FROM=noreply@naapurustot.fi
# Origin used to build the reset links AND the Stripe Checkout success/cancel and
# customer-portal return URLs. Must match the deployed frontend.
APP_BASE_URL=https://naapurustot.fi

# Supporter subscription via Stripe (https://stripe.com). Leave STRIPE_SECRET_KEY
# empty to disable the paid tier entirely — checkout/portal and the webhook answer 503
# and every other endpoint is unaffected. STRIPE_PRICE_ID is the recurring Price id for
# the supporter plan (the price lives in Stripe, never in the app). STRIPE_WEBHOOK_SECRET
# is the signing secret for /billing/webhook. Set STRIPE_TAX_ENABLED=true only once
# registered for EU VAT One-Stop-Shop (vero.fi) with a Tax origin address in Stripe —
# enabling it before that makes Checkout fail.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=

# Bitcoin / Lightning PRO — an optional, PREPAID, TIME-BOXED supporter tier. Bitcoin has
# no recurring subscription, so a payment buys a fixed WINDOW of PRO that lapses on its
# own (renewing early stacks). Leave LIGHTNING_PROVIDER empty to disable it entirely —
# checkout and the webhook answer 503 and everything else is unaffected.
#
# Provider-agnostic: choose the processor and set its keys. 'opennode' is the reference
# custodial processor (a self-hosted BTCPay adapter can be added). VERIFY the adapter
# against the provider's live API before enabling in production.
LIGHTNING_PROVIDER=
OPENNODE_API_KEY=
# https://api.opennode.com (live) or https://dev-api.opennode.com (test).
OPENNODE_BASE_URL=
# Origin the provider webhook is called back on (default https://api.naapurustot.fi).
API_BASE_URL=
# Prices in EUR CENTS, VAT-inclusive (the price lives here, never hard-coded in the app).
# A plan is offered only when its price is set — set one or both. Match your Stripe monthly
# price for the 30-day window and offer a discounted yearly (e.g. ~10× the monthly).
LIGHTNING_PRICE_EUR_MONTH=
LIGHTNING_PRICE_EUR_YEAR=
# Optional — window length each plan buys, in days (defaults: 30 and 365).
LIGHTNING_WINDOW_DAYS_MONTH=
LIGHTNING_WINDOW_DAYS_YEAR=

# Optional — Sentry error tracking for the API. Leave empty to disable.
SENTRY_DSN=
SENTRY_RELEASE=

# Optional — days of pg_dump backups to retain in server/backups/ (default 14).
BACKUP_RETENTION_DAYS=
