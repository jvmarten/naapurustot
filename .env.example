# Map constructor defaults. On load the app fits the viewport to the default
# all-Finland view (or the ?city= region), so center/zoom mostly matter as a
# pre-fit fallback. MIN_ZOOM must stay low enough for the whole-country view
# (zoom ~4.8) — clamping it higher breaks the default landing view.
VITE_MAP_CENTER_LNG=24.94
VITE_MAP_CENTER_LAT=60.17
VITE_MAP_ZOOM=9.2
VITE_MAP_MIN_ZOOM=2
VITE_MAP_MAX_ZOOM=16

# Basemap tile URLs (CARTO)
VITE_BASEMAP_LIGHT_URL=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}@2x.png
VITE_BASEMAP_DARK_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png
# Labels-only overlay rendered above the choropleth so place names stay
# readable on top of the colored fills.
VITE_BASEMAP_LIGHT_LABELS_URL=https://basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}@2x.png
VITE_BASEMAP_DARK_LABELS_URL=https://basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}@2x.png

# Optional — Sentry error tracking. Leave empty to disable.
# The DSN is public/safe to expose; source map upload secrets are CI-only.
VITE_SENTRY_DSN=

# Optional — Digitransit subscription key. Powers street-address search in the
# search box. Register free at https://digitransit.fi/en/developers/ . When empty,
# address search degrades to name/postal-code search only (no failing requests).
# Baked into the client bundle (static app) — free + rate-limited, so rotate it in
# the portal if abused.
# NOTE: the travel-time isochrone ("Reachable area") feature is currently DISABLED
# in code — Digitransit's Routing v1 API (its isochrone endpoint) was decommissioned
# on 2025-04-03 and OTP2 has no isochrone support. See src/utils/isochrone.ts.
VITE_DIGITRANSIT_API_KEY=
# Routing graph: 'finland' (whole country), 'hsl' (Helsinki region), or 'waltti'.
# Only relevant to the (currently disabled) isochrone feature.
VITE_DIGITRANSIT_ROUTER=finland

# Optional — Cloudflare Turnstile site key. Renders the bot-check widget on the
# signup form (src/components/Turnstile.tsx). This is the PUBLIC key and is safe to
# commit / ship in the client bundle; the matching SECRET key goes only in
# server/.env as TURNSTILE_SECRET. When empty, no widget renders and signup is
# refused server-side in production (allowed in dev). Create a widget at
# https://dash.cloudflare.com → Turnstile, hostnames naapurustot.fi + www.naapurustot.fi.
VITE_TURNSTILE_SITE_KEY=
