{
  "name": "naapurustot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "dist:check": "node scripts/check-dist-size.mjs --profile pages",
    "queue:check": "node scripts/check-actions-queue.mjs",
    "test:e2e": "playwright test --project=e2e --project=mobile",
    "test:visual": "playwright test --project=visual",
    "test:visual:ci": "node scripts/visual-gate.mjs",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "build:data": "node scripts/build_region_data.mjs && node scripts/build_national_ranges.mjs && node scripts/build_region_aggregates.mjs && node scripts/build_grid_data.mjs && node scripts/build_planning_data.mjs && node scripts/build_buildings_data.mjs && node scripts/update_slug_aliases.mjs",
    "refresh:planning": "python scripts/fetch_vayla_projects.py && python scripts/fetch_city_zoning.py && node scripts/build_planning_data.mjs",
    "build:pages": "node scripts/prerender-hubs.mjs && node scripts/prerender.mjs && node scripts/build_open_data.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs && node scripts/generate-llms.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "@turf/area": "^7.3.4",
    "@turf/bbox": "^7.3.4",
    "@turf/boolean-intersects": "^7.3.4",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^5.20.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "topojson-client": "^3.1.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "topojson-server": "^3.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.5",
    "nanoid": "^3.3.17",
    "serialize-javascript": ">=7.0.3",
    "undici": "^7.29.0"
  }
}
